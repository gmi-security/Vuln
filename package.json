{
  "name": "gmi-vuln",
  "version": "0.1.0",
  "private": true,
  "description": "GMI Vuln - vulnerability scan orchestration, management, and risk quantification console",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-app.mjs",
    "lint": "eslint",
    "build:summary-worker": "tsc -p tsconfig.summary-worker.json",
    "worker:summary": "node --max-old-space-size=1024 scripts/spotlight-summary-worker.mjs",
    "build:reporting-worker": "tsc -p tsconfig.reporting-worker.json",
    "worker:reporting": "node --max-old-space-size=512 scripts/customer-reporting-worker.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.41.1",
    "@types/pg": "^8.23.1",
    "lucide-react": "^1.60.0",
    "next": "16.4.1",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.3.1",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
