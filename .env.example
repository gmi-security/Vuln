# --- Persistence (REQUIRED in production) ----------------------------------
# Postgres connection string. WITHOUT this the store lives only in process
# memory and every redeploy/restart wipes all companies, scans, findings, and
# asset inventory. Point at a managed Postgres (e.g. DO Managed Postgres).
DATABASE_URL=

# Elastic coverage page is released; set false to hide its page and navigation.
ELASTIC_VULN_ENABLED=true
# Synthetic preview only. Never indicates a successful live refresh.
ELASTIC_VULN_SAMPLE_DATA=false
# Optional separate Postgres storage. The direct-query dashboard otherwise uses
# its own tables in DATABASE_URL. The legacy n8n snapshot endpoint requires this.
# Staging must always use a staging database.
ELASTIC_VULN_DATABASE_URL=
# Dedicated n8n -> app bearer secret, minimum 32 characters. Never NEXT_PUBLIC_.
ELASTIC_VULN_INGEST_TOKEN=
# Set true in staging to prevent automatic scanner syncs and report emails.
# This does not disable manual integration actions; omit integration credentials.
VULN_DISABLE_SCHEDULER=false

# --- Admin recovery token (optional) ---------------------------------------
# Shared secret gating the two admin recovery endpoints /api/admin/purge-demo
# and /api/admin/resync (data cleanup / rebuild from Nessus). Everyday actions
# — threat-intel refresh and OSINT scans — are session-gated buttons in the
# app and need no token. Generate with: openssl rand -hex 32. The two admin
# endpoints fail closed (401) when this is unset.
ADMIN_TOKEN=

# --- Authentication (GitHub OAuth, restricted to a GitHub org) -------------
# Create a GitHub OAuth App (Settings -> Developer settings -> OAuth Apps).
# Homepage URL:            https://<your-app-url>
# Authorization callback:  https://<your-app-url>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only active members of this GitHub org may sign in.
GMI_ALLOWED_ORG=gmi-security
# Public base URL of the app and a random session secret
# (generate with: openssl rand -base64 32).
NEXTAUTH_URL=https://<your-app-url>
NEXTAUTH_SECRET=

# Nessus (Tenable) — real scan orchestration via the Nessus REST API.
# Authenticated requests send "X-ApiKeys: accessKey=...; secretKey=...".
# All three must be set for the connector to leave demo mode.
NESSUS_URL=https://your-nessus-host:8834
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=
# Nessus usually ships with a self-signed certificate; set to 1 to skip TLS
# verification for the scanner connection only.
NESSUS_TLS_INSECURE=1

# Vulners — package audit and CVE/exploit intelligence (demo until set).
VULNERS_API_KEY=

# Vulners Bridge — active nmap --script vulners scan via VulnOps Core API
# (independent of VULNERS_API_KEY above; either can be set on its own).
VULNERS_BRIDGE_URL=
VULNERS_BRIDGE_API_KEY=

# CrowdStrike Falcon Spotlight — endpoint vulnerability telemetry (demo until set).
# This first (unsuffixed) tenant is optional to name: set FALCON_CUSTOMER to pin
# all its devices/findings to that client company, or leave it unset to attach
# to GMI's own internal org (own-estate deployment) — unchanged default behavior.
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
FALCON_CLOUD=us-2
FALCON_CUSTOMER=

# Additional CrowdStrike tenants — an MSSP client with their own separate
# Falcon CID, distinct from GMI's own estate above. Add as many as needed by
# incrementing the suffix (FALCON_CLIENT_ID_2, _3, ...); each one MUST set its
# own FALCON_CUSTOMER_N (there can only be one unnamed "default" tenant) or
# that tenant is skipped with a warning in the logs.
# FALCON_CLIENT_ID_2=
# FALCON_CLIENT_SECRET_2=
# FALCON_CLOUD_2=us-2
# FALCON_CUSTOMER_2=Atlas HealthCare

# Qualys VMDR — planned integration.
QUALYS_API_URL=
QUALYS_USERNAME=
QUALYS_PASSWORD=

# Microsoft Intune — managed-device inventory via Microsoft Graph (endpoints
# attach to the internal org). Entra app with DeviceManagementManagedDevices.Read.All.
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# CrowdStrike Falcon host inventory reuses the FALCON_* scanner credentials
# above (device inventory = coverage perspective; Spotlight = vuln perspective).

# GMI GRC (OpenGRC) — push vuln risks + PCI DSS posture for audit/compliance.
# Token from the GRC Profile Settings (Sanctum).
GRC_API_URL=https://your-opengrc-host
GRC_API_TOKEN=

# n8n — generic pull-based pipe into one workflow on the GMI n8n instance,
# for a data source that doesn't have (or doesn't yet need) its own
# dedicated connector. Point it at that workflow's production webhook URL.
# Supplemental only — runs alongside the existing scanners, nothing is
# wired to it yet beyond a reachability probe (see lib/n8n.ts).
N8N_WEBHOOK_URL=
# Optional — sent as X-N8N-API-KEY if the webhook node requires header auth.
# N8N_API_KEY=

# Microsoft Defender Vulnerability Management — device CVE findings via the
# Security API. Entra app granted Vulnerability.Read.All (WindowsDefenderATP).
DEFENDER_TENANT_ID=
DEFENDER_CLIENT_ID=
DEFENDER_CLIENT_SECRET=
# Optional: attach Defender findings to a specific client company (else the
# internal org).
# DEFENDER_CUSTOMER=

# Tidal.io — per-customer asset inventory (feeds real-risk environment
# context: asset exposure + business criticality, mapped to customers).
# API key comes from the portal Profile -> Settings page.
TIDAL_API_URL=https://api.tidal.io
TIDAL_API_KEY=
TIDAL_PROFILE_ID=
# Optional override if the assets endpoint path differs:
# TIDAL_ASSETS_PATH=/v1/assets
