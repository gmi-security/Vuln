# --- Authentication (GitHub OAuth, restricted to a GitHub org) -------------
# Create a GitHub OAuth App (Settings -> Developer settings -> OAuth Apps).
# Homepage URL:            https://<your-app-url>
# Authorization callback:  https://<your-app-url>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only active members of this GitHub org may sign in.
GMI_ALLOWED_ORG=gmi-security
# Public base URL of the app and a random session secret
# (generate with: openssl rand -base64 32).
NEXTAUTH_URL=https://<your-app-url>
NEXTAUTH_SECRET=

# Nessus (Tenable) — real scan orchestration via the Nessus REST API.
# Authenticated requests send "X-ApiKeys: accessKey=...; secretKey=...".
# All three must be set for the connector to leave demo mode.
NESSUS_URL=https://your-nessus-host:8834
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=
# Nessus usually ships with a self-signed certificate; set to 1 to skip TLS
# verification for the scanner connection only.
NESSUS_TLS_INSECURE=1

# Vulners — package audit and CVE/exploit intelligence (demo until set).
VULNERS_API_KEY=

# CrowdStrike Falcon Spotlight — endpoint vulnerability telemetry (demo until set).
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
FALCON_CLOUD=us-2

# Qualys VMDR — planned integration.
QUALYS_API_URL=
QUALYS_USERNAME=
QUALYS_PASSWORD=

# Microsoft Intune — managed-device inventory via Microsoft Graph (endpoints
# attach to the internal org). Entra app with DeviceManagementManagedDevices.Read.All.
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# CrowdStrike Falcon host inventory reuses the FALCON_* scanner credentials
# above (device inventory = coverage perspective; Spotlight = vuln perspective).

# Tidal.io — per-customer asset inventory (feeds real-risk environment
# context: asset exposure + business criticality, mapped to customers).
# API key comes from the portal Profile -> Settings page.
TIDAL_API_URL=https://api.tidal.io
TIDAL_API_KEY=
TIDAL_PROFILE_ID=
# Optional override if the assets endpoint path differs:
# TIDAL_ASSETS_PATH=/v1/assets
