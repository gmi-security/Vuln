{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": ".worker-build/spotlight-summary",
    "noEmitOnError": true
  },
  "include": ["lib/spotlight-summary-worker.ts", "lib/spotlight-summary-retention.ts", "lib/customer-saved-sources.ts", "lib/customer-source-authority.ts"]
}
